<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Trust the app's API domain explicitly -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">app.byndai.in</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Base config: trust system CAs for all other domains -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
